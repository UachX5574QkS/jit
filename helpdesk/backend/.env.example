# Helpdesk backend — development environment configuration.
# Copy to `.env` and adjust for your laptop. `.env` is gitignored.

# HTTP server
PORT=3000
# Comma-separated list of origins allowed by CORS in dev (the Angular dev server).
CORS_ORIGIN=http://localhost:4200

# Session cookie (dev only). Replaced by IDCS token auth in the ORDS deployment.
SESSION_COOKIE_NAME=helpdesk_sid
# Used later to sign/verify the dev session cookie. Set a real value in .env.
SESSION_SECRET=dev-only-change-me

# Local PostgreSQL connection (database `helpdesk`, user `helpdesk`).
PGHOST=localhost
PGPORT=5432
PGDATABASE=helpdesk
PGUSER=helpdesk
PGPASSWORD=helpdesk
# Optional pool tuning
PG_POOL_MAX=10

# Locally running Ollama service used for the New-workflow Step 3 summary.
# The summary is display-only; on any error/timeout the workflow falls back to
# showing the entered values and still allows submission (R2.12).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Short server-side timeout (ms) so an unavailable model degrades quickly.
OLLAMA_TIMEOUT_MS=4000
